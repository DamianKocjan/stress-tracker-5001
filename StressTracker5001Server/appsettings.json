{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Tags": {
    "MaxTagsPerBoard": 20,
    "MaxTagsPerCard": 5
  },
  "BoardInvites": {
    "MaxActiveInvitesPerBoard": 5,
    "DefaultInviteExpiryHours": 24,
    "InviteChars": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
    "InviteTokenLength": 12
  },
  "Auth": {
    "TokenChars": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyz",
    "TokenLength": 32,
    "PasswordReset": {
      "TokenExpiryMinutes": 60
    },
    "EmailVerification": {
      "TokenExpiryMinutes": 1440
    }
  },
  "EmailService": {
    "Type": "Mock"
  },
  "FileStorage": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".txt",
      ".rtf",
      ".xls",
      ".xlsx",
      ".csv",
      ".ods",
      ".ppt",
      ".pptx",
      ".odp",
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".svg",
      ".webp",
      ".ico",
      ".zip",
      ".rar",
      ".7z",
      ".tar",
      ".gz",
      ".js",
      ".ts",
      ".jsx",
      ".tsx",
      ".json",
      ".xml",
      ".html",
      ".css",
      ".py",
      ".java",
      ".cpp",
      ".c",
      ".cs",
      ".mp3",
      ".wav",
      ".flac",
      ".aac",
      ".m4a",
      ".mp4",
      ".avi",
      ".mov",
      ".mkv",
      ".webm",
      ".flv"
    ]
  },
  "Cloudflare": {
    "AccountId": "",
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "BucketName": "stress-tracker-uploads",
    "PublicUrl": ""
  },
  "AllowedHosts": "*"
}
