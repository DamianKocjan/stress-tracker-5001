{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Tags": {
    "MaxTagsPerBoard": 20,
    "MaxTagsPerCard": 5
  },
  "BoardInvites": {
    "MaxActiveInvitesPerBoard": 5,
    "DefaultInviteExpiryHours": 24,
    "InviteChars": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
    "InviteTokenLength": 12
  },
  "Auth": {
    "TokenChars": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyz",
    "TokenLength": 32,
    "PasswordReset": {
      "TokenExpiryMinutes": 60
    },
    "EmailVerification": {
      "TokenExpiryMinutes": 1440
    }
  },
  "EmailService": {
    "Type": "Mock"
  },
  "FileStorage": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".jpg",
      ".jpeg",
      ".png",
      ".txt",
      ".zip",
      ".xlsx",
      ".pptx"
    ]
  },
  "Cloudflare": {
    "AccountId": "",
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "BucketName": "stress-tracker-uploads",
    "PublicUrl": ""
  },
  "AllowedHosts": "*"
}
