{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Tags": {
    "MaxTagsPerBoard": 20,
    "MaxTagsPerCard": 5
  },
  "BoardInvites": {
    "MaxActiveInvitesPerBoard": 5,
    "DefaultInviteExpiryHours": 24,
    "InviteChars": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
    "InviteTokenLength": 12
  },
  "AllowedHosts": "*"
}
